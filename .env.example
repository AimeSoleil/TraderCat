# Database
DATABASE_URL=postgresql+asyncpg://tradercat:tradercat@localhost:5432/tradercat

# API
API_TITLE=TraderCat API
API_VERSION=2.0.0

# Pipeline
PIPELINE_SCHEDULE_HOUR=20
PIPELINE_TIMEZONE=America/New_York
PIPELINE_MAX_CONCURRENCY=5

# AI/LLM
TRADERCAT_AI_TOKEN=your_github_copilot_token_here
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_PERSONA=wyckoff

# Limits
DEFAULT_MAX_SYMBOLS_PER_USER=50

# Logging
LOG_FORMAT=json
LOG_LEVEL=INFO

# Run Mode
# Options: 'api-only' (API without scheduler), 'scheduler' (pipeline only), 'combined' (both - legacy)
RUN_MODE=combined

# Initial Admin User (used during database migration)
# These values are only used when seeding the initial admin user
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@tradercat.local
ADMIN_MAX_SYMBOLS=100
